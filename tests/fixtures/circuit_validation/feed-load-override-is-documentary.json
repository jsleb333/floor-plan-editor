{
  "name": "feed-load-override-is-documentary",
  "description": "A feed's own load_w override documents what it draws where it originates: sources are excluded from the connected-device sum, so the circuit reports only the outlet's 180 W.",
  "document": {
    "devices": [
      {
        "id": "feed-1",
        "type": "feed_down",
        "attachment": {
          "wall_id": "wall-1",
          "segment_index": 0,
          "t": 6.0
        },
        "load_w": 3000.0
      },
      {
        "id": "out-1",
        "type": "outlet",
        "attachment": {
          "wall_id": "wall-1",
          "segment_index": 0,
          "t": 12.0
        }
      }
    ],
    "circuits": [
      {
        "id": "circ-1",
        "name": "Circuit 1",
        "color": "#dc2626",
        "breaker_a": 15,
        "voltage_v": 120,
        "kind": "power"
      }
    ],
    "wires": [
      {
        "id": "w-1",
        "circuit_id": "circ-1",
        "from_device_id": "feed-1",
        "to_device_id": "out-1"
      }
    ]
  },
  "expected": {
    "circuits": [
      {
        "circuit_id": "circ-1",
        "load_w": 180.0,
        "amps": 1.5,
        "breaker_a": 15,
        "status": "ok",
        "connected_device_ids": [
          "out-1"
        ],
        "floating_device_ids": []
      }
    ],
    "unassigned_device_ids": [],
    "multi_circuit_device_ids": {},
    "dangling_wire_ids": [],
    "has_source": true
  }
}
